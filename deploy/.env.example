# Caminho público da aplicação (URL: http://servidor/16flow/)
VITE_BASE_PATH=/16flow

# Porta interna no host (apenas 127.0.0.1 — proxy pelo nginx do servidor)
# Não usa 80 nem 8080 (já ocupadas por outras aplicações)
WEB_BIND=127.0.0.1
WEB_PORT=9080

# Nome do projeto Docker Compose (isolamento de outras stacks: sga, mysql-*, etc.)
COMPOSE_PROJECT_NAME=projeto-sge

# Credenciais para ./deploy.sh import-backlog (login na API)
ADMIN_EMAIL=gestor@sge.local
ADMIN_PASSWORD=Sge@2026

# Segredo JWT — altere em produção (mín. 32 caracteres)
JWT_SECRET=altere-este-segredo-em-producao-com-32-chars-min

# Validade do token
JWT_EXPIRES_IN=8h

# Driver do banco da API: sqlite (padrão, schema completo) ou mysql
DB_DRIVER=sqlite

# MariaDB (container db) — obrigatório no compose; usado quando DB_DRIVER=mysql
MYSQL_ROOT_PASSWORD=root_sge_pm_change_me
MYSQL_DATABASE=sge_pm
MYSQL_USER=sge_pm
MYSQL_PASSWORD=sge_pm_change_me
