# Porta HTTP exposta pelo frontend (nginx)
WEB_PORT=8080

# Segredo JWT — altere em produção (mín. 32 caracteres)
JWT_SECRET=altere-este-segredo-em-producao-com-32-chars-min

# Validade do token
JWT_EXPIRES_IN=8h

# Driver do banco da API: sqlite (padrão, schema completo) ou mysql
DB_DRIVER=sqlite

# MariaDB (container db) — obrigatório no compose; usado quando DB_DRIVER=mysql
MYSQL_ROOT_PASSWORD=root_sge_pm_change_me
MYSQL_DATABASE=sge_pm
MYSQL_USER=sge_pm
MYSQL_PASSWORD=sge_pm_change_me
