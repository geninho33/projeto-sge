# Frontend 16Flow — build + nginx (publicado em /16flow)
FROM node:20-alpine AS builder

ARG VITE_BASE_PATH=/16flow
ENV VITE_BASE_PATH=${VITE_BASE_PATH}

WORKDIR /repo

COPY package.json package-lock.json ./
COPY sge-pm-web/package.json ./sge-pm-web/

RUN npm ci --workspace=sge-pm-web

COPY sge-pm-web/ ./sge-pm-web/

RUN npm run build -w sge-pm-web

FROM nginx:1.27-alpine

COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf
# Assets sob /16flow/ no document root
COPY --from=builder /repo/sge-pm-web/dist /usr/share/nginx/html/16flow

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=4 \
  CMD wget -qO- http://127.0.0.1/16flow/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
